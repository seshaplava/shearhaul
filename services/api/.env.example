PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/sharehaul?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
JWT_EXPIRES_SEC=604800
OTP_TTL_SEC=300
OTP_DEV_CODE=123456

# Providers: console|msg91 · local|azure|s3 · mock|razorpay · db|fcm · haversine|google · manual|hyperverge
SMS_PROVIDER=console
STORAGE_PROVIDER=local
PAYMENTS_PROVIDER=mock
PUSH_PROVIDER=db
MAPS_PROVIDER=haversine
KYC_PROVIDER=manual

# MSG91 (when SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=SHRHAUL

# Razorpay (when PAYMENTS_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Azure Blob (when STORAGE_PROVIDER=azure) — preferred cloud
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=sharehaul-docs

# Optional AWS S3 (legacy; prefer azure)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Local file storage fallback
LOCAL_STORAGE_DIR=
LOCAL_STORAGE_PUBLIC_BASE=

# Firebase FCM (when PUSH_PROVIDER=fcm)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Maps (when MAPS_PROVIDER=google)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# HyperVerge KYC (when KYC_PROVIDER=hyperverge)
HYPERVERGE_APP_ID=
HYPERVERGE_APP_KEY=
HYPERVERGE_BASE_URL=https://ind.idv.hyperverge.co/v1
